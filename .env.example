# Copy to `.env.local` (git-ignored) and adjust. All variables are optional.
# EXPO_PUBLIC_* variables are inlined in the JS bundle at build time:
# never put secrets in them. Restart `npx expo start -c` after changing them.

# Base URL of a REST API exposing GET /stores and GET /stores/:id.
# Empty → the built-in mock API (120 stores) is used.
EXPO_PUBLIC_API_URL=

# Stores per page for the infinite scroll (5–100, default 15).
EXPO_PUBLIC_PAGE_SIZE=15

# Mock API only: simulated latency in ms (0–10000, default 600).
EXPO_PUBLIC_MOCK_LATENCY_MS=600

# Mock API only: probability (0–1) that a request fails, to demo error states (default 0).
EXPO_PUBLIC_MOCK_FAILURE_RATE=0

# Android native builds only (not needed for Expo Go / iOS). Read by app.config.ts.
GOOGLE_MAPS_ANDROID_API_KEY=
